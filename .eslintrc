{
  "extends": [
    "airbnb-base"
  ],
  "plugins": [
    "eslint-plugin-import"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "array-bracket-spacing": [
      "error",
      "always",
      {
        "singleValue": false
      }
    ],
    "arrow-parens": [
      "error",
      "as-needed"
    ],
    "comma-dangle": [
      "error",
      "never"
    ],
    "consistent-return": "off",
    "import/extensions": [
      "error",
      {
        "js": "always"
      }
    ],
    "max-len": [
      "warn",
      150
    ],
    "no-param-reassign": "off",
    "no-plusplus": [
      "off",
      {
        "allowForLoopAfterthoughts": true
      }
    ],
    "radix": [
      "error",
      "as-needed"
    ]
  },
  "env": {
    "browser": true,
    "webextensions": true
  }
}
