{
  "name": "inbox-reborn",
  "version": "0.5.9.3",
  "packageManager": "yarn@3.1.1",
  "type": "module",
  "engines": {
    "node": ">=16.13.1"
  },
  "scripts": {
    "build": "sass src/scss/content/index.scss:src/css/content.css src/scss/options.scss:src/css/options.css src/scss/outlook/index.scss:src/css/outlook.css --no-source-map",
    "watch": "sass src/scss/content/index.scss:src/css/content.css src/scss/options.scss:src/css/options.css src/scss/outlook/index.scss:src/css/outlook.css -w --source-map",
    "js:lint": "$(npm bin)/eslint './src/**/*.js'",
    "js:lint:fix": "$(npm bin)/eslint './src/**/*.js' --fix"
  },
  "devDependencies": {
    "@types/eslint": "^8.2.2",
    "eslint": "^8.6.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-import": "^2.25.4",
    "sass": "^1.47.0"
  }
}
